{
  "name": "gocell-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11.4.0"
  },
  "scripts": {
    "dev": "pnpm -F @gocell/web dev",
    "build": "pnpm -F @gocell/web build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "codegen": "pnpm -F @gocell/codegen generate"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vue-tsc": "catalog:"
  }
}
